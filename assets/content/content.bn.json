        {
          "id": "sentence_building",
          "title": "Sentence Building",
          "entries": [
            { "en": "I eat rice.", "bn": "আমি ভাত খাই।", "roman": "ami bhat khai." },
            { "en": "I am eating rice.", "bn": "আমি ভাত খাচ্ছি।", "roman": "ami bhat khachchi." },
            { "en": "I will eat rice.", "bn": "আমি ভাত খাব।", "roman": "ami bhat khabo." },
            { "en": "I ate rice.", "bn": "আমি ভাত খেয়েছি।", "roman": "ami bhat kheyechi." },
            { "en": "I want to eat.", "bn": "আমি খেতে চাই।", "roman": "ami khete chai." },
            { "en": "I can eat.", "bn": "আমি খেতে পারি।", "roman": "ami khete pari." },
            { "en": "I need to eat.", "bn": "আমার খেতে হবে।", "roman": "amar khete hobe." },
            { "en": "I like rice.", "bn": "আমার ভাত পছন্দ।", "roman": "amar bhat pochondo." },
            { "en": "I know.", "bn": "আমি জানি।", "roman": "ami jani." },
            { "en": "I don’t know.", "bn": "আমি জানি না।", "roman": "ami jani na." },
            { "en": "I understand.", "bn": "আমি বুঝি।", "roman": "ami bujhi." },
            { "en": "I don’t understand.", "bn": "আমি বুঝতে পারছি না।", "roman": "ami bujhte parchi na." },
            { "en": "I live in...", "bn": "আমি ... থাকি।", "roman": "ami ... thaki." },
            { "en": "I am going to...", "bn": "আমি ... যাচ্ছি।", "roman": "ami ... jachchi." },
            { "en": "I came from...", "bn": "আমি ... থেকে এসেছি।", "roman": "ami ... theke eshechi." },
            { "en": "Can I...?", "bn": "আমি কি ... করতে পারি?", "roman": "ami ki ... korte pari?" }
          ]
        },
        {
          "id": "questions_negation_existence",
          "title": "Questions, Negation & “Have/There Is”",
          "entries": [
            { "en": "Do you...?", "bn": "আপনি কি ...?", "roman": "apni ki ...?" },
            { "en": "What is this?", "bn": "এটা কী?", "roman": "eta ki?" },
            { "en": "Who is this?", "bn": "ইনি কে?", "roman": "ini ke?" },
            { "en": "Where is it?", "bn": "এটা কোথায়?", "roman": "eta kothay?" },
            { "en": "Why?", "bn": "কেন?", "roman": "keno?" },
            { "en": "When?", "bn": "কখন?", "roman": "kokhon?" },
            { "en": "I don’t want it.", "bn": "আমি এটা চাই না।", "roman": "ami eta chai na." },
            { "en": "I cannot.", "bn": "আমি পারি না।", "roman": "ami pari na." },
            { "en": "Not now.", "bn": "এখন না।", "roman": "ekhon na." },
            { "en": "There is / it exists.", "bn": "আছে।", "roman": "ache." },
            { "en": "There isn’t / none.", "bn": "নেই।", "roman": "nei." },
            { "en": "Do you have...?", "bn": "আপনার কি ... আছে?", "roman": "apnar ki ... ache?" },
            { "en": "I have...", "bn": "আমার ... আছে।", "roman": "amar ... ache." },
            { "en": "I don’t have...", "bn": "আমার ... নেই।", "roman": "amar ... nei." },
            { "en": "That’s okay / no problem.", "bn": "কোনো সমস্যা নেই।", "roman": "kono shomossha nei." }
