    {
      "id": "basic_sentences",
      "title": "Basic Sentences",
      "lessons": [
        {
          "id": "greetings_goodbyes",
          "title": "Greetings & Goodbyes",
          "entries": [
            { "en": "Hello, how are you?", "bn": "আপনি কেমন আছেন?", "roman": "apni kemon achen?" },
            { "en": "I am fine, thank you.", "bn": "আমি ভালো আছি, ধন্যবাদ।", "roman": "ami bhalo achi, dhonnobad." },
            { "en": "What is your name?", "bn": "আপনার নাম কী?", "roman": "apnar nam ki?" },
            { "en": "My name is...", "bn": "আমার নাম...", "roman": "amar nam..." },
            { "en": "Nice to meet you.", "bn": "আপনার সাথে দেখা হয়ে ভালো লাগলো।", "roman": "apnar shathe dekha hoye bhalo laglo." },
            { "en": "Good morning.", "bn": "সুপ্রভাত।", "roman": "shuprobhat." },
            { "en": "Good night.", "bn": "শুভ রাত্রি।", "roman": "shubho ratri." },
            { "en": "Goodbye.", "bn": "বিদায়।", "roman": "biday." },
            { "en": "See you later.", "bn": "পরে দেখা হবে।", "roman": "pore dekha hobe." },
            { "en": "Take care.", "bn": "সাবধানে থেকো।", "roman": "shabdhane theko." },
            { "en": "Welcome.", "bn": "স্বাগতম।", "roman": "shagotom." },
            { "en": "Long time no see.", "bn": "অনেক দিন পর দেখা।", "roman": "onek din por dekha." },
            { "en": "How is your family?", "bn": "আপনার পরিবার কেমন আছে?", "roman": "apnar poribar kemon ache?" },
            { "en": "I am happy to be here.", "bn": "আমি এখানে এসে খুশি।", "roman": "ami ekhane ese khushi." },
            { "en": "Please come in.", "bn": "ভেতরে আসুন।", "roman": "bhetore ashun." },
            { "en": "Have a good day.", "bn": "আপনার দিনটি ভালো কাটুক।", "roman": "apnar dinti bhalo katuk." },
            { "en": "I have to go now.", "bn": "আমাকে এখন যেতে হবে।", "roman": "amake ekhon jete hobe." },
            { "en": "Thank you for everything.", "bn": "সব কিছুর জন্য ধন্যবাদ।", "roman": "shob kichur jonno dhonnobad." },
            { "en": "It was nice talking to you.", "bn": "আপনার সাথে কথা বলে ভালো লাগলো।", "roman": "apnar shathe kotha bole bhalo laglo." },
            { "en": "Stay well.", "bn": "ভালো থাকবেন।", "roman": "bhalo thakben." }
          ]
        },
        {
          "id": "travel",
          "title": "Useful Travel Sentences",
          "entries": [
            { "en": "Where is the bathroom?", "bn": "বাথরুম কোথায়?", "roman": "bathroom kothay?" },
            { "en": "How much is this?", "bn": "এটার দাম কত?", "roman": "etar dam koto?" },
            { "en": "I want to go to...", "bn": "আমি ... যেতে চাই।", "roman": "ami ... jete chai." },
            { "en": "Please stop here.", "bn": "এখানে থামুন।", "roman": "ekhane thamun." },
            { "en": "I am lost.", "bn": "আমি পথ হারিয়েছি।", "roman": "ami poth hariyechi." },
            { "en": "Can you help me?", "bn": "আপনি কি আমাকে সাহায্য করতে পারেন?", "roman": "apni ki amake shahajjo korte paren?" },
            { "en": "I don't understand.", "bn": "আমি বুঝতে পারছি না।", "roman": "ami bujhte parchi na." },
            { "en": "Please speak slowly.", "bn": "দয়া করে ধীরে বলুন।", "roman": "doya kore dhire bolun." },
            { "en": "Do you speak English?", "bn": "আপনি কি ইংরেজি বলতে পারেন?", "roman": "apni ki ingreji bolte paren?" },
            { "en": "Where is the station?", "bn": "স্টেশন কোথায়?", "roman": "steshon kothay?" },
            { "en": "How do I get there?", "bn": "আমি সেখানে কীভাবে যাব?", "roman": "ami shekhane kibhabe jabo?" },
            { "en": "I need a taxi.", "bn": "আমার একটি ট্যাক্সি দরকার।", "roman": "amar ekti taxi dorkar." },
            { "en": "Is it far from here?", "bn": "এটা কি এখান থেকে দূরে?", "roman": "eta ki ekhan theke dure?" },
            { "en": "I am hungry.", "bn": "আমার খিদে পেয়েছে।", "roman": "amar khide peyeche." },
            { "en": "I am thirsty.", "bn": "আমার তৃষ্ণা পেয়েছে।", "roman": "amar trishna peyeche." },
            { "en": "Water, please.", "bn": "একটু জল দিন।", "roman": "ektu jol din." },
            { "en": "The food is delicious.", "bn": "খাবারটা খুব সুস্বাদু।", "roman": "khabarta khub shushadu." },
            { "en": "Where can I buy tickets?", "bn": "টিকিট কোথায় কিনতে পারি?", "roman": "tikit kothay kinte pari?" },
            { "en": "Please wait a moment.", "bn": "একটু অপেক্ষা করুন।", "roman": "ektu opekkha korun." },
            { "en": "What time is it?", "bn": "এখন কয়টা বাজে?", "roman": "ekhon koyta baje?" }
          ]
        },
        {
          "id": "table_manners",
          "title": "Polite Table Phrases",
          "//": "For the dinner table when visiting the family. Accepting food graciously goes a long way.",
          "entries": [
            { "en": "Just a little, please.", "bn": "একটু দিন।", "roman": "ektu din." },
            { "en": "That's enough, thank you.", "bn": "এতেই হবে, ধন্যবাদ।", "roman": "etei hobe, dhonnobad." },
            { "en": "I am full.", "bn": "আমার পেট ভরে গেছে।", "roman": "amar pet bhore geche." },
            { "en": "I can't eat any more.", "bn": "আমি আর খেতে পারব না।", "roman": "ami ar khete parbo na." },
            { "en": "It is very tasty.", "bn": "খুব সুস্বাদু।", "roman": "khub shushadu." },
            { "en": "May I have a little more?", "bn": "আমি আরেকটু নিতে পারি?", "roman": "ami arektu nite pari?" },
            { "en": "No more, thank you.", "bn": "আর না, ধন্যবাদ।", "roman": "ar na, dhonnobad." },
            { "en": "The tea is wonderful.", "bn": "চা টা দারুণ।", "roman": "cha ta darun." },
            { "en": "May I have some water?", "bn": "একটু জল পাব?", "roman": "ektu jol pabo?" },
            { "en": "I have eaten very well.", "bn": "আমি খুব ভালো খেয়েছি।", "roman": "ami khub bhalo kheyechi." },
            { "en": "Thank you for the lovely meal.", "bn": "এত সুন্দর খাবারের জন্য ধন্যবাদ।", "roman": "eto shundor khabarer jonno dhonnobad." },
            { "en": "Please don't go to any trouble.", "bn": "দয়া করে কষ্ট করবেন না।", "roman": "doya kore koshto korben na." },
            { "en": "I really like homemade food.", "bn": "ঘরের খাবার আমার খুব পছন্দ।", "roman": "ghorer khabar amar khub pochondo." },
            { "en": "It smells delicious.", "bn": "গন্ধটা দারুণ।", "roman": "gondhota darun." },
            { "en": "Just a little rice, please.", "bn": "একটু ভাত দিন।", "roman": "ektu bhat din." },
            { "en": "Can I help in the kitchen?", "bn": "আমি কি রান্নাঘরে সাহায্য করতে পারি?", "roman": "ami ki rannaghore shahajjo korte pari?" }
          ]
        },
        {
          "id": "impress_family",
          "title": "Impress Her Family",
          "entries": [
            { "en": "I am learning Bengali.", "bn": "আমি বাংলা শিখছি।", "roman": "ami bangla shikhchi." },
            { "en": "Your daughter is very special to me.", "bn": "আপনার মেয়ে আমার কাছে খুব বিশেষ।", "roman": "apnar meye amar kache khub bishesh." },
            { "en": "The food is very tasty.", "bn": "রান্না খুব সুস্বাদু হয়েছে।", "roman": "ranna khub shushadu hoyeche." },
            { "en": "Thank you for having me.", "bn": "আমাকে আমন্ত্রণ জানানোর জন্য ধন্যবাদ।", "roman": "amake amontron jananor jonno dhonnobad." },
            { "en": "I respect you very much.", "bn": "আমি আপনাকে খুব শ্রদ্ধা করি।", "roman": "ami apnake khub shroddha kori." },
            { "en": "Your home is beautiful.", "bn": "আপনার বাড়ি খুব সুন্দর।", "roman": "apnar bari khub shundor." },
            { "en": "I am happy to be part of your family.", "bn": "আপনার পরিবারের অংশ হতে পেরে আমি খুশি।", "roman": "apnar poribarer ongsho hote pere ami khushi." },
            { "en": "Can I help you?", "bn": "আমি কি সাহায্য করতে পারি?", "roman": "ami ki shahajjo korte pari?" },
            { "en": "Please teach me more Bengali.", "bn": "আমাকে আরও বাংলা শেখান।", "roman": "amake aro bangla shekhan." },
            { "en": "I made a small mistake, sorry.", "bn": "আমি একটু ভুল করেছি, দুঃখিত।", "roman": "ami ektu bhul korechi, dukkhito." },
            { "en": "I love Bengali culture.", "bn": "আমি বাঙালি সংস্কৃতি ভালোবাসি।", "roman": "ami bangali shongskriti bhalobashi." },
            { "en": "You cook very well.", "bn": "আপনি খুব ভালো রান্না করেন।", "roman": "apni khub bhalo ranna koren." },
            { "en": "I will visit again.", "bn": "আমি আবার আসব।", "roman": "ami abar ashbo." },
            { "en": "I feel at home here.", "bn": "আমি এখানে নিজের বাড়ির মতো অনুভব করি।", "roman": "ami ekhane nijer barir moto onubhob kori." },
            { "en": "Please don't trouble yourself.", "bn": "দয়া করে কষ্ট করবেন না।", "roman": "doya kore koshto korben na." },
            { "en": "May I have a little more?", "bn": "আমি কি আরেকটু পেতে পারি?", "roman": "ami ki arektu pete pari?" },
            { "en": "Everything is wonderful.", "bn": "সব কিছু চমৎকার।", "roman": "shob kichu chomotkar." },
            { "en": "I am grateful to you.", "bn": "আমি আপনার কাছে কৃতজ্ঞ।", "roman": "ami apnar kache kritoggo." },
            { "en": "I hope to see you again soon.", "bn": "আশা করি আবার শিগগিরই দেখা হবে।", "roman": "asha kori abar shiggiri dekha hobe." },
            { "en": "With your blessings.", "bn": "আপনার আশীর্বাদে।", "roman": "apnar ashirbade." },
            { "en": "You have raised a wonderful daughter.", "bn": "আপনি খুব ভালো একটি মেয়ে মানুষ করেছেন।", "roman": "apni khub bhalo ekti meye manush korechen." },
            { "en": "I will take good care of her.", "bn": "আমি ওর খুব যত্ন নেব।", "roman": "ami or khub jotno nebo." },
            { "en": "Please forgive my broken Bengali.", "bn": "আমার ভাঙা বাংলা ক্ষমা করবেন।", "roman": "amar bhanga bangla khoma korben." },
            { "en": "It is an honour to meet you.", "bn": "আপনার সাথে দেখা হওয়া আমার সৌভাগ্য।", "roman": "apnar shathe dekha howa amar shoubhaggo." }
          ]
        }
      ]
    }
  ]
}
