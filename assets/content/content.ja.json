      "lessons": [
        {
          "id": "greetings_goodbyes",
          "title": "Greetings & Goodbyes",
          "entries": [
            { "en": "Hello, how are you?", "bn": "こんにちは、お元気ですか？", "roman": "konnichiwa, ogenki desu ka?" },
            { "en": "I am fine, thank you.", "bn": "元気です、ありがとう。", "roman": "genki desu, arigato." },
            { "en": "What is your name?", "bn": "お名前は何ですか？", "roman": "onamae wa nan desu ka?" },
            { "en": "My name is...", "bn": "私の名前は…です。", "roman": "watashi no namae wa ... desu." },
            { "en": "Nice to meet you.", "bn": "はじめまして。", "roman": "hajimemashite." },
            { "en": "Good morning.", "bn": "おはようございます。", "roman": "ohayo gozaimasu." },
            { "en": "Good night.", "bn": "おやすみなさい。", "roman": "oyasuminasai." },
            { "en": "Goodbye.", "bn": "さようなら。", "roman": "sayonara." },
            { "en": "See you later.", "bn": "またあとで。", "roman": "mata ato de." },
            { "en": "Take care.", "bn": "気をつけて。", "roman": "ki o tsukete." },
            { "en": "Welcome.", "bn": "ようこそ。", "roman": "yokoso." },
            { "en": "Long time no see.", "bn": "お久しぶりです。", "roman": "ohisashiburi desu." },
            { "en": "Thank you very much.", "bn": "どうもありがとうございます。", "roman": "domo arigato gozaimasu." },
            { "en": "You are welcome.", "bn": "どういたしまして。", "roman": "do itashimashite." },
            { "en": "Excuse me.", "bn": "すみません。", "roman": "sumimasen." },
            { "en": "I am sorry.", "bn": "ごめんなさい。", "roman": "gomen nasai." },
            { "en": "Have a good day.", "bn": "よい一日を。", "roman": "yoi ichinichi o." },
            { "en": "I have to go now.", "bn": "もう行かなければなりません。", "roman": "mo ikanakereba narimasen." },
            { "en": "Thank you for everything.", "bn": "いろいろありがとうございました。", "roman": "iroiro arigato gozaimashita." },
            { "en": "See you tomorrow.", "bn": "また明日。", "roman": "mata ashita." }
          ]
        },
        {
          "id": "travel",
          "title": "Useful Travel Sentences",
          "entries": [
            { "en": "Where is the bathroom?", "bn": "トイレはどこですか？", "roman": "toire wa doko desu ka?" },
            { "en": "How much is this?", "bn": "これはいくらですか？", "roman": "kore wa ikura desu ka?" },
            { "en": "I want to go to...", "bn": "…に行きたいです。", "roman": "... ni ikitai desu." },
            { "en": "Please stop here.", "bn": "ここで止めてください。", "roman": "koko de tomete kudasai." },
            { "en": "I am lost.", "bn": "道に迷いました。", "roman": "michi ni mayoimashita." },
            { "en": "Can you help me?", "bn": "手伝ってもらえますか？", "roman": "tetsudatte moraemasu ka?" },
